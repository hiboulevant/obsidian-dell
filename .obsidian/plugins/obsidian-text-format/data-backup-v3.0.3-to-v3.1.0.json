    }
  ],
  "RequestList": [],
  "customReplaceList": [
    {
      "name": "Remove trailing spaces",
      "data": [
        {
          "search": "(\\s*)(?=\\n)|(\\s*)$",
          "replace": ""
        }
      ],
      "id": "41d6995e-c90f-497b-b3f2-c1caec105980"
    },
    {
      "name": "Remove blank line(s)",
      "data": [
        {
          "search": "\\n\\s*\\n",
          "replace": "\\n"
        }
      ],
      "id": "a09e5337-7f7b-4eca-92e1-37d064019815"
    },
    {
      "name": "Add extra line break between paragraphs",
      "data": [
        {
          "search": "\\n",
          "replace": "\\n\\n"
        }
      ],
      "id": "d9586bbe-5e1b-47e8-aecb-db7848eab4a5"
    },
    {
      "name": "Split line(s) by blanks",
      "data": [
        {
          "search": " ",
          "replace": "\\n"
        }
      ],
      "id": "884eb89c-4c78-46d6-8339-e79dee81f319"
    }
  ],
  "customReplaceBuiltInLog": {
