      "id": "remove-trailing-spaces",
      "modified": false,
      "data": [
        {
          "search": "(\\s*)(?=\\n)|(\\s*)$",
          "replace": ""
        }
      ]
    },
    "remove-blank-line": {
      "id": "remove-blank-line",
