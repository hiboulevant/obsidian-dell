4 \u0003 \u000b \u0003 \f \u0002 \u0003 \u0013 \u0011 ˘ \u0002 \r \u0006 \u0007 \u0002 \f \u0010 \u0007 \u000e ˙ \u0003 › \f \f \u0003 \u000b \u0010 \u0004 \u0013 \u000f \u0007 \u0003 \u000b \f − \u0010 \u0017˘ \u0011 \r \u0007 \u0002 \u0006 \u0013 \u0003 \u000b \u0003 \f \u0002 \u0003 \u0017\u000e \u000b \u0010 \u0007 \u0002 \u0007 \u0010 \u0011 \u0006 – \u0003 \u000b \u0003 \f \u0002 \u0003 ˘ \r \u0010 \t \r \u0003 \u0007 \u0003 \u000b \u000f \u0003 \u0004 \u0011 \u000f \u0007 \u0010 \u0006 \u0003 \u000b \u0003 \u0004 \u0011 \u0006 \u0003 \u0006 \u0007 \u0011 \u000f \r \u0002 ˇ \u0003 ˘ \u0011 \u000f \r \u0003 — \u0002 \u0010 \r \u0003 — \u0002 \u0013 ƒ \u0003 \u0013 \u0004 \u0003 \u0004 \u0010 \u0007 \u000f \u0002 \u0007 \u0010 \u0011 \u0006 \u0004 \u0003 \u000b \u0010 — — \u0010 \u0013 \u0010 \f \u0004 ˙ \u0003 ‰\u0002 \r \u0010 \u0011 \u0003 \u0011 — — \r \u0003 \u0004 \u0011 \u0006 \u0003 \u0004 \u0011 \u000f \u0007 \u0010 \u0006 \u0003 \u0007 \u0003 \u000b \u0004 \u0003 \u0013 \u0011 \u0006 \u0004 \u0010 \f \u0004 – \u0003 \u0004 \u0011 \u000f \f \u0010 ˇ \u0006 \u0002 \u0006 \u0007 \u0003 \f − \u0010 \u0017˘ \u0011 \r \u0007 \u0002 \u0006 \u0013 \u000b \u0003 \f − \u000f \u0006 \u0010 \u0007 \u000e \u0003 \u0013 \u0011 \r ˘ \u0004 ‹ \u0004 ˘ \r \u0010 \u0007 \u0003 \u0007 \u0003 \u000b \u000f \u0003 \u000b \u0010 \u0004 \u0013 \r \u0006 \u0017 \u0006 \u0007 \u0003 \u0004 ˘ \u0010 \r \u0010 \u0007 \u000f \f \u0003 \u000b \u0002 \u0006 \u0004 \u0003 \f \u0002 \u0003 ˇ \u0004 \u0007 \u0010 \u0011 \u0006 \u0003 \u000b \u0004 \u0003 \u0013 \u0011 \u0006 — \f \u0010 \u0007 \u0004 \u0003 \u0007 \u0003 \f \u000b \u000e \u0012 \f \u0011 ˘ ˘ \u0017 \u0006 \u0007 \u0003 ˘ \r \u0004 \u0011 \u0006 \u0006 \f ˙ „ p t ‡ i o s g l k \u0003 q h o u l k “ \u0003 \u0016 \u0002 \r \u0011 \f \u0010 \u0006 ” \u0003 \u0016 \u0011 \u0006 \u0007 \u0010 \u0006 \u000f \r \u0003 ƒ \u0003 ˘ \r \u0002 \u0007 \u0010 ‘ \u000f \r \u0003 \f \u0002 \u0003 \u0017\u000e \u000b \u0010 \u0007 \u0002 \u0007 \u0010 \u0011 \u0006 \u0003 ‘ \u000f \u0011 \u0007 \u0010 \u000b \u0010 \u0006 \u0006 \u0017 \u0006 \u0007 \u0003 ˘ \u0011 \u000f \r \u0003 ˇ \u000e \r \r \u0003 \f \u0003 \u0004 \u0007 \r \u0004 \u0004 \u0003 \u0007 \u0017\u0002 \u0010 \u0006 \u0007 \u0006 \u0010 \r \u0003 \f − \u000e ‘ \u000f \u0010 \f \u0010 ’ \r \u0003 \u000e \u0017\u0011 \u0007 \u0010 \u0011 \u0006 \u0006 \f ˙ “ \u0003 \u0016 \u0002 \r \u0011 \f \u0010 \u0006 ” \u0003 ‚ \r \u000e ˘ \u0002 \r \r \u0003 \u0007 \u0003 \u0017\u0017 \u0006 \r \u0003 ‰\u0010 \r \u0002 \u0003 ƒ \u0003 \u0004 \u0011 \u0006 \u0003 \u0013 \u0011 \u000f \r \u0004 \u0003 \u000b \u0003 \u0006 \u0002 \u0007 \u0002 \u0007 \u0010 \u0011 \u0006 ˙ “ \u0003 \u0016 \u0002 \r \u0011 \f \u0010 \u0006 ” \u0003 ™ \u0010 \u0006 \u0002 \f \u0010 \u0004 \r \u0003 \f \u0002 \u0003 \u0012 \u0006 \u0007 \u0003 \u000b \u0003 \u0004 \u0011 \u0006 \u0003 \u0002 ˘ ˘ \u0002 \r \u0007 \u0017 \u0006 \u0007 \u0003 \u0002 \u0013 \u0007 \u000f \f \u0003 \u0007 \u0003 ˘ \r \u000e ˘ \u0002 \r \r \u0003 \f \u0003 \u000b \u000e \u0017\u000e \u0006 \u0002 ˇ \u0017 \u0006 \u0007 ˙ “ \u0003 \u0016 \u0002 \r \u0011 \f \u0010 \u0006 ” \u0003 ‚ \f \u0002 \u0006 \u0010 — \u0010 \r \u0003 \f \u0004 \u0003 \u0002 \u0013 \u0007 \u0010 \u0012 \u0010 \u0007 \u000e \u0004 \u0003 \u000b − \u000e \u0007 \u000e \u0003 ˘ \u0011 \u000f \r \u0003 ‰\u0010 \r \u0002 – \u0003 \u0005 \u0003 \u0013 \u0011 \u0017˘ \r \u0010 \u0004 \u0003 \f − \u0010 \u0006 \u0004 \u0013 \r \u0010 ˘ \u0007 \u0010 \u0011 \u0006 \u0003 \u0002 \u000f ⁄ \u0003 \u0013 \u0002 \u0017˘ \u0004 \u0003 \u000b \u0003 ﬁ \u0011 \u000f \r ˙ “ \u0003 \u0016 \u0002 \r \u0011 \f \u0010 \u0006 ” \u0003 \u0016 \u0011 \u0011 \r \u000b \u0011 \u0006 \u0006 \r \u0003 \f \u0004 \u0003 \u0012 \u0010 \u0004 \u0010 \u0007 \u0004 \u0003 \u0004 \u0007 \u0010 \u0012 \u0002 \f \u0004 \u0003 \u000b \u0003 \u0004 \u0002 \u0003 — \u0002 \u0017\u0010 \f \f \u0003 ﬂ — \r \t \r \u0003 \u0007 \u0003 ˘ \u0002 \r \u0006 \u0007 \u0004 Ł \u0003 \u0002 \u000f \u0003 \u0016 \u0002 \u0006 \u0002 \u000b \u0002 ˙ “ \u0003 \u0016 \u0002 \r \u0011 \f \u0010 \u0006 ” \u0003 ‰\u0002 \u0010 \u0006 \u0007 \u0006 \u0010 \r \u0003 \u000f \u0006 \u0003 \u0013 \u0011 \u0017\u0017\u000f \u0006 \u0010 \u0013 \u0002 \u0007 \u0010 \u0011 \u0006 \u0003 \u0011 \u000f \u0012 \r \u0007 \u0003 \u0007 \u0003 \b \u0011 \u0006 \u0006 Œ \u0007 \u0003 \u0002 \u0012 \u0013 \u0003 ‰\u0010 \r \u0002 \u0003 \u0013 \u0011 \u0006 \u0013 \r \u0006 \u0002 \u0006 \u0007 \u0003 \f \u0004 \u0004 \u0010 \u0007 \u000f \u0002 \u0007 \u0010 \u0011 \u0006 \u0004 \u0003 \u000b \u0010 — — \u0010 \u0013 \u0010 \f \u0004 \u0003 \u0007 \u0003 \f \u0004 \u0003 \u000e \u0017\u0011 \u0007 \u0010 \u0011 \u0006 \u0004 ˙ “ \u0003 \u0016 \u0002 \r \u0011 \f \u0010 \u0006 ” \u0003 \u0016 \u0011 \u0006 \u0007 \u0010 \u0006 \u000f \r \u0003 ƒ \u0003 ˇ \u000e \r \r \u0003 \f \u0002 \u0003 \u0013 \u0011 ˘ \u0002 \r \u0006 \u0007 \u0002 \f \u0010 \u0007 \u000e \u0003 \u000b \u0003 \u0017\u0002 \u0006 \u0010 \t \r \u0003 \r \u0004 ˘ \u0011 \u0006 \u0004 \u0002 ’ \f \u0003 \u0017\u0002 \f ˇ \r \u000e \u0003 \f \u0004 \u000b \u0010 — — \u0010 \u0013 \u000f \f \u0007 \u000e \u0004 \u0003 \u0002 \u0012 \u0013 \u0003 \f \u0003 ˘ \t \r \u0003 \u000b \u0003 ‰\u0010 \r \u0002 ˙ “ \u0003 \u0016 \u0002 \r \u0011 \f \u0010 \u0006 ” \u0003 Š \u0013 \u0011 \u000f \u0007 \r \u0003 \f \u0002 \u0003 \u0013 \b \u0002 \u0006 \u0004 \u0011 \u0006 \u0003 \u000b − \u0014 \u0006 \u0006 \u0003 Ÿ \u0005 \f \f \u0002 \u0003 \u0004 \u000f \r \u0003 ‰\u0002 \r \u0010 – \u0003 \r \u0013 \u0011 \u0017\u0017\u0002 \u0006 \u000b \u000e \u0003 ˘ \u0002 \r \u0003 ‰\u0002 \r \u0010 \u0011 ˙ “ \u0003 ‰\u0002 \r \u0010 \u0011 ” \u0003 › \u0006 \u0012 \u0011 \u0005 \r \u0003 ƒ \u0003 \u0016 \u0002 \r \u0011 \f \u0010 \u0006 \u0003 \f \u0003 \f \u0010 \u0006 \u0003 Ž \u0011 \u000f ı \u000f ’ \u0003 \u000b \u0003 \f \u0002 \u0003 \u0013 \b \u0002 \u0006 \u0004 \u0011 \u0006 \u0003 \u000b − \u0014 \u0006 \u0006 \u0003 Ÿ \u0005 \f \f \u0002 \u0003 \u0004 \u000f \r \u0003 ‰\u0002 \r \u0010 ˙ “ \u0003 \u0016 \u0002 \r \u0011 \f \u0010 \u0006 \u0003 \u0007 \u0003 ‰\u0002 \r \u0010 \u0011 ” \u0003 Ÿ \u0003 \r \u0007 \r \u0011 \u000f \u0012 \r \u0003 ˘ \u0011 \u000f \r \u0003 \f \u0002 \u0003 ˘ \r \u0011 \u0013 \b \u0002 \u0010 \u0006 \u0003 \u0004 \u000e \u0002 \u0006 \u0013 \u0003 \f \u0003 ﬁ \u000f \u000b \u0010 \u0003 ł \u0003 — \u000e \u0012 \r \u0010 \r \u0003 ƒ \u0003 \f \u0002 \u0003 \u0017Œ \u0017 \b \u000f \r ˙ e f g h i j k l œq m s h o h s t g \u0003 š h \u0003 e u t p h \u0003 „ t r p \u0003 ž l \u0003 e h p l k k \u0016 \u0002 \r \u0011 \f \u0010 \u0006 \u0003 ˘ \u0002 \r \u0007 \u0002 ˇ \u0003 \u0004 \u0004 \u0003 \u000b \u0010 — — \u0010 \u0013 \u000f \f \u0007 \u000e \u0004 \u0003 \r \u000e \u0013 \u0006 \u0007 \u0004 \u0003 \u0007 \u0003 \f \u0004 \u0003 \u0004 \u0007 \r \u0002 \u0007 \u000e ˇ \u0010 \u0004 \u0003 ‘ \u000f − \f \f \u0003 \u000f \u0007 \u0010 \f \u0010 \u0004 \u0003 ˘ \u0011 \u000f \r \u0003 ˇ \u000e \r \r \u0003 \f \u0004 \u0007 \r \u0004 \u0004 – \u0003 \u0006 \u0011 \u0007 \u0002 \u0017\u0017 \u0006 \u0007 \u0003 \f \u0002 \u0003 \u0017\u000e \u000b \u0010 \u0007 \u0002 \u0007 \u0010 \u0011 \u0006 – \u0003 \f \u0003 \u0004 ˘ \u0011 \r \u0007 \u0003 \u0007 \u0003 \f \u0003 \u0004 \u0011 \u000f \u0007 \u0010 \u0006 \u0003 \u000b \u0003 \u0004 \u0004 \u0003 ˘ \u0002 \r \u0006 \u0007 \u0004 ˙ \u0003 › \f \f \u0003 \u0017 \u0006 \u0007 \u0010 \u0011 \u0006 \u0006 \u0003 \u000f \u0006 ˘ \r \u0010 \t \r \u0003 \u000b \u0003 \u0013 \r \u0010 \u0004 \u0003 ‘ \u000f − \f \f \u0003 \r \u000e \u0013 \u0010 \u0007 \u0003 ˘ \u0006 \u000b \u0002 \u0006 \u0007 \u0003 \u0004 \u0004 \u0003 \u0017\u000e \u000b \u0010 \u0007 \u0002 \u0007 \u0010 \u0011 \u0006 \u0004 \u0003 ˘ \u0011 \u000f \r \u0003 — \u0002 \u0010 \r \u0003 — \u0002 \u0013 \u0003 \u0002 \u000f ⁄ \u0003 \u0017\u0011 \u0017 \u0006 \u0007 \u0004 \u000b \u0010 — — \u0010 \u0013